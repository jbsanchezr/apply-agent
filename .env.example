# Copy to .env and adjust. Every variable is optional; the defaults run the
# project on the bundled fixtures with no credentials at all.

# fake (default) | gmail
APPLY_AGENT_EMAIL_PROVIDER=fake
APPLY_AGENT_FIXTURES_DIR=tests/fixtures/emails

# Gmail only. Keep these files outside the repository.
# APPLY_AGENT_GMAIL_CLIENT_SECRETS_PATH=~/.config/apply_agent/client_secret.json
# APPLY_AGENT_GMAIL_TOKEN_PATH=~/.config/apply_agent/gmail_token.json

# SQLite database for the applications table.
APPLY_AGENT_DATABASE_URL=sqlite:///apply_agent.db

# baseline (default, keyword rules) | ollama (free, local) | anthropic (needs ANTHROPIC_API_KEY)
APPLY_AGENT_LLM=baseline
# APPLY_AGENT_OLLAMA_MODEL=qwen3:8b
# APPLY_AGENT_OLLAMA_BASE_URL=http://localhost:11434
# APPLY_AGENT_OLLAMA_NUM_CTX=8192
# APPLY_AGENT_ANTHROPIC_MODEL=claude-opus-5
# APPLY_AGENT_ANTHROPIC_EFFORT=low
# APPLY_AGENT_ANTHROPIC_REFUSAL_FALLBACK=true
# APPLY_AGENT_MAX_AGENT_STEPS=4
# APPLY_AGENT_INITIAL_LOOKBACK_DAYS=90
# Days without news before an open application is flagged as quiet.
# APPLY_AGENT_QUIET_AFTER_DAYS=14

# Langfuse tracing (off by default). The SDK reads LANGFUSE_PUBLIC_KEY,
# LANGFUSE_SECRET_KEY and LANGFUSE_HOST. Use a self-hosted host for real mail.
# APPLY_AGENT_LANGFUSE_ENABLED=false
# APPLY_AGENT_LANGFUSE_REDACT_BODIES=true

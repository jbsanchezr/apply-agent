# Copy to .env and adjust. Every variable is optional; the defaults run the
# project on the bundled fixtures with no credentials at all.

# fake (default) | gmail
APPLY_AGENT_EMAIL_PROVIDER=fake
APPLY_AGENT_FIXTURES_DIR=tests/fixtures/emails

# Gmail only. Keep these files outside the repository.
# APPLY_AGENT_GMAIL_CLIENT_SECRETS_PATH=~/.config/apply_agent/client_secret.json
# APPLY_AGENT_GMAIL_TOKEN_PATH=~/.config/apply_agent/gmail_token.json

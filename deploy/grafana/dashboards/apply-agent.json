    {
      "id": 18,
      "type": "row",
      "title": "Applications",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "Applications by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
